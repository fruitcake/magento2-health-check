<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="fruitcake_healthcheck/general/key" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>
    <type name="Fruitcake\HealthCheck\Observer\Check\SearchEngine">
        <arguments>
            <argument name="testers" xsi:type="array">
                <item name="core" xsi:type="object">Fruitcake\HealthCheck\Model\SearchEngine\CoreConnectionTester</item>
                <item name="amasty" xsi:type="object">Fruitcake\HealthCheck\Model\SearchEngine\AmastyConnectionTester</item>
                <item name="elasticsuite" xsi:type="object">Fruitcake\HealthCheck\Model\SearchEngine\ElasticsuiteConnectionTester</item>
            </argument>
        </arguments>
    </type>
</config>
