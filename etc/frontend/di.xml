<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\App\RouterList">
        <arguments>
            <argument name="routerList" xsi:type="array">
                <item name="fruitcake_healthcheck" xsi:type="array">
                    <item name="class" xsi:type="string">Fruitcake\HealthCheck\Controller\Router</item>
                    <item name="disable" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">5</item>
                </item>
            </argument>
        </arguments>
    </type>
    <!-- Monitoring probes are not visitors -->
    <type name="Magento\Customer\Model\Visitor">
        <arguments>
            <argument name="ignores" xsi:type="array">
                <item name="fruitcake_healthcheck" xsi:type="boolean">true</item>
            </argument>
        </arguments>
    </type>
</config>
