{
    "name": "fruitcake/magento2-health-check",
    "description": "Magento 2 health check endpoint with pluggable checks",
    "keywords": [
        "magento",
        "magento2",
        "health check",
        "monitoring"
    ],
    "license": [
        "MIT"
    ],
    "type": "magento2-module",
    "authors": [
        {
            "name": "Fruitcake",
            "email": "info@fruitcake.nl"
        }
    ],
    "require": {
        "php": "^8.1",
        "magento/framework": "^103.0",
        "magento/module-advanced-search": "*",
        "magento/module-backend": "*",
        "magento/module-config": "*",
        "magento/module-indexer": "*",
        "magento/module-search": "*",
        "magento/module-store": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Fruitcake\\HealthCheck\\": ""
        },
        "exclude-from-classmap": [
            "/Test/"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://mirror.mage-os.org/",
            "only": [
                "magento/*"
            ]
        }
    ],
    "config": {
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": false,
            "magento/magento-composer-installer": false,
            "magento/inventory-composer-installer": false,
            "laminas/laminas-dependency-plugin": false
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
